{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2024"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": [
    "app/**/*.mts",
    "types/**/*.d.ts"
  ]
}
